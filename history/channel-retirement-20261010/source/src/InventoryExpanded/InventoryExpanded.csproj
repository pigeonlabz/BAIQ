    <Target Name="ValidateIl2CppReferenceProfile" BeforeTargets="ResolveReferences"
            Condition="'$(Configuration)' == 'IL2CPP' Or '$(Configuration)' == 'IL2CPP_BETA_047'">
        <PropertyGroup>
            <_AssemblyCSharpReference>$(S1Dir)\MelonLoader\Il2CppAssemblies\Assembly-CSharp.dll</_AssemblyCSharpReference>
        </PropertyGroup>
        <Message Importance="high" Text="Reference profile: $(ReferenceProfile) ($(ReferenceGameVersion)); directory: $(S1Dir)" />
        <Error Condition="!Exists('$(_AssemblyCSharpReference)')"
               Text="Reference profile $(ReferenceProfile) is missing Assembly-CSharp.dll at $(_AssemblyCSharpReference). Use its preserved reference directory." />
        <ItemGroup>
            <_ReferenceFingerprint Include="$(_AssemblyCSharpReference)" />
        </ItemGroup>
        <GetFileHash Files="@(_ReferenceFingerprint)" Algorithm="SHA256">
            <Output TaskParameter="Items" ItemName="_ReferenceFingerprintWithHash" />
        </GetFileHash>
        <Message Importance="high" Text="Assembly-CSharp SHA-256: @(_ReferenceFingerprintWithHash->'%(FileHash)')" />
        <Error Condition="'@(_ReferenceFingerprintWithHash->'%(FileHash)')' != '$(ExpectedAssemblyCSharpSha256)'"
               Text="Wrong reference set for $(ReferenceProfile): expected $(ExpectedAssemblyCSharpSha256), got @(_ReferenceFingerprintWithHash->'%(FileHash)') at $(_AssemblyCSharpReference)." />
    </Target>

